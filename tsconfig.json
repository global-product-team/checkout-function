{
  "include": ["env.d.ts", "**/*.ts", "**/*.tsx", ".react-router/types/**/*", "extensions/checkout-ui-react-version/src/Checkout.jsx"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "removeComments": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "baseUrl": ".",
    "types": ["@react-router/node", "vite/client", "@shopify/polaris-types"],
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      // 🚨 이 부분을 수정합니다.
      "@shopify/ui-extensions/preact": [
        "node_modules/@shopify/ui-extensions/preact"
      ]
      // 기존: "node_modules/@shopify/ui-extensions/build/ts/preact.d.ts"
    }

  }
}
